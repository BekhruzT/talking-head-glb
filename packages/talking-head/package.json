{
  "name": "talking-head-glb",
  "version": "0.1.0",
  "description": "A React talking-head component for any ARKit-rigged GLB, with a head library and a speech connector.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BekhruzT/talking-head-glb.git",
    "directory": "packages/talking-head"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./heads": {
      "types": "./dist/heads/index.d.ts",
      "source": "./src/heads/index.ts",
      "default": "./dist/heads.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "source": "./src/server/index.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "talking-head-glb": "./cli/talking-head.mjs"
  },
  "files": [
    "dist",
    "cli"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "microsoft-cognitiveservices-speech-sdk": "^1.30.1"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.78.2",
    "@react-three/fiber": "^8.13.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": ">=0.154.0"
  },
  "devDependencies": {
    "@react-three/drei": "^9.78.2",
    "@react-three/fiber": "^8.13.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/three": "^0.154.0",
    "jsdom": "^31.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.154.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
