{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/setup-tests.ts"]
}
